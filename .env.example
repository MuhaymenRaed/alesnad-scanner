# Copy this file to .env and fill in real values. NEVER commit .env.
# Placeholders only — nothing in this file is a working credential.
#
# Only variables prefixed with VITE_ are sent to the browser. Secrets must NEVER use that prefix
# (the Vite config refuses to start if a VITE_ variable looks like a secret).

# ─── ERPNext (server-side only) ───────────────────────────────────────────────
# Base URL of your ERPNext site. Must be https:// in production. Changing it needs no frontend rebuild.
ERPNEXT_BASE_URL=https://your-erpnext-instance.example.com
# API key + secret of a dedicated, read-only integration user (see README → "ERPNext integration user").
ERPNEXT_API_KEY=
ERPNEXT_API_SECRET=
# The SELLING price list prices are read from. There is never a fallback to another list.
ERPNEXT_PRICE_LIST=Standard Selling
# Optional: allow a price list that is ALSO flagged "Buying" in ERPNext (default false — it may hold costs).
# ERPNEXT_ALLOW_BUYING_PRICE_LIST=false
# Optional: upstream request timeout in milliseconds (default 10000).
# ERPNEXT_TIMEOUT_MS=10000
# Optional (recommended for multi-company sites): only Items of this company can be looked up —
# an Item belongs to it when Item → Item Defaults has a row for the company. Items of other
# companies are never read and are reported as "not found".
# ERPNEXT_COMPANY=
# Optional: restrict lookups to these item groups (comma-separated; sub-groups included). Empty = all.
# ERPNEXT_ITEM_GROUPS=
# Optional: extra Item fields shown under "More details" (standard or custom fieldnames, comma-separated).
# Cost/supplier/accounting fields are always blocked. Default:
# ITEM_METADATA_FIELDS=country_of_origin,customs_tariff_number,shelf_life_in_days,warranty_period
# Optional: what to do with disabled Items — "warn" (show with a warning, default) or "reject" (treat as not found).
# DISABLED_ITEM_POLICY=warn
# Optional: if no barcode matches, also try an exact Item Code match (default false).
# LOOKUP_MATCH_ITEM_CODE=false

# ─── Backend ──────────────────────────────────────────────────────────────────
PORT=3001
# Browser origin(s) allowed to call the API (comma-separated). Used for CORS and for Clerk's
# authorized-parties (azp) check. In production: your public https:// frontend URL.
FRONTEND_ORIGIN=http://localhost:5173
# Optional: set when running behind a reverse proxy (e.g. 1 = trust one proxy hop).
# TRUST_PROXY=1
# Optional: lookups per minute per signed-in user (default 120).
# LOOKUP_RATE_LIMIT_PER_MINUTE=120
# Optional: debug | info | warn | error | silent (default info).
# LOG_LEVEL=info

# ─── Clerk authentication ─────────────────────────────────────────────────────
# Publishable key (public, used by the browser AND the backend). Dashboard → API keys.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_with_your_clerk_publishable_key
# Secret key (server-side only!). Dashboard → API keys.
CLERK_SECRET_KEY=sk_test_replace_with_your_clerk_secret_key
# Optional: Clerk "JWKS public key" (PEM) for networkless token verification. Dashboard → API keys.
# CLERK_JWT_KEY=
# Optional: opt out of Clerk SDK telemetry in development.
# CLERK_TELEMETRY_DISABLED=1
# Optional: show the custom sign-up page (default false — staff are invited from the Clerk Dashboard).
# VITE_ENABLE_SIGN_UP=false

# ─── Optional access policy (enforced on the backend) ─────────────────────────
# Empty = every signed-in Clerk user may use the scanner.
# ACCESS_ALLOWED_USER_IDS=user_xxx,user_yyy
# ACCESS_DENIED_USER_IDS=

# ─── Optional frontend setting ────────────────────────────────────────────────
# Only if the API is served from a different origin than the frontend (default: same-origin /api).
# VITE_API_BASE_URL=https://scanner-api.example.com
